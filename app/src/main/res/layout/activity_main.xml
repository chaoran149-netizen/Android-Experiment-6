<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="6dp">
        <Button android:id="@+id/tab_profile" style="@style/SecondaryButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp"
            android:text="@string/main_title" android:textSize="13sp"/>
        <Button android:id="@+id/tab_pair" style="@style/SecondaryButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp"
            android:text="@string/two_cards" android:textSize="13sp"/>
        <Button android:id="@+id/tab_triple" style="@style/SecondaryButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp"
            android:text="@string/three_cards" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
